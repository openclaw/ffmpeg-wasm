{
  "name": "@steipete/ffmpeg-wasm-local",
  "version": "0.0.0",
  "private": true,
  "description": "Local lightweight FFmpeg/FFprobe WebAssembly build for browser and Node media workflows.",
  "license": "MIT",
  "bin": {
    "ffmpeg-wasm": "./lib/src/cli.js",
    "ffprobe-wasm": "./lib/src/ffprobe-cli.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    }
  },
  "scripts": {
    "build": "pnpm compile && node lib/scripts/build.js",
    "check": "pnpm compile && pnpm lint && pnpm docs:build:compiled && pnpm format:check",
    "clean": "rimraf dist lib .cache/build",
    "compile": "tsgo -p tsconfig.json && chmod +x lib/src/cli.js lib/src/ffprobe-cli.js lib/src/run-generated.js lib/scripts/build.js lib/scripts/build-docs-site.js lib/scripts/playground-e2e.js lib/scripts/playground-server.js lib/scripts/verify.js",
    "docs:build": "pnpm compile && pnpm docs:build:compiled",
    "docs:build:compiled": "node lib/scripts/build-docs-site.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --tsconfig tsconfig.json --deny-warnings .",
    "playground": "pnpm compile && node lib/scripts/playground-server.js",
    "playground:e2e": "pnpm compile && node lib/scripts/playground-e2e.js",
    "test:e2e": "pnpm build && pnpm verify",
    "verify": "pnpm compile && node lib/scripts/verify.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "7.0.0-dev.20260606.1",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2"
}
